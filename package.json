{
  "name": "event-registration-attendance-system",
  "version": "0.1.0",
  "private": true,
  "description": "KMUTT student activity event registration and attendance system",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm --workspace=server run dev",
    "build": "npm --workspace=server run build && npm --workspace=client run build",
    "db:migrate": "prisma migrate deploy --schema=server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "test": "npm --workspace=server run test",
    "test:unit": "npm --workspace=server run test:unit",
    "test:api": "npm --workspace=server run test:api",
    "test:e2e": "echo \"Playwright e2e placeholder for sprint 1\""
  },
  "keywords": [],
