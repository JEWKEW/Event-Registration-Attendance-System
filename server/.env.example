# Runtime environment mode ("development" locally, "production" on Cloud Run, "test" in Vitest)
NODE_ENV=development

# HTTP listening port (Cloud Run injects PORT automatically)
PORT=3000

# PostgreSQL connection string (in Cloud Run, injected from Secret Manager via /cloudsql/ unix socket)
DATABASE_URL=postgresql://app:app@localhost:5432/events

# Isolated PostgreSQL connection string for automated tests
DATABASE_URL_TEST=postgresql://app:app@localhost:5433/events_test

# Session signing secret (minimum 32 characters; stored in Secret Manager in production)
SESSION_SECRET=change-me-session-secret-key-at-least-32-chars

# Session idle timeout in minutes
SESSION_IDLE_MINUTES=120

# Bcrypt password hashing cost factor
BCRYPT_ROUNDS=12

# Allowed CORS origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# Initial password for seeded demo users (in Cloud Run, injected from Secret Manager)
SEED_DEMO_PASSWORD=local-demo-only
# DEMO_USER_PASSWORD=change-me

# Application display and business logic timezone
APP_TIMEZONE=Asia/Bangkok

# Optional build/release commit identifier returned by /api/health
# GIT_COMMIT=v0.1.0-dev
